# Normalize line endings on commit; Windows checkouts keep CRLF for shell scripts.
* text=auto

*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf

*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary assets never get text treatment.
*.png  binary
*.jpg  binary
*.webp binary
*.woff2 binary
*.sqlite binary
