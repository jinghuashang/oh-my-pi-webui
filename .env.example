# Access key for WebUI API/WebSocket authentication. Optional once a WebUI
# account exists (see the initialization flow on the login page), and always
# usable as a machine-to-machine credential.
WEBUI_API_KEY=change-me-to-a-long-random-string

# Backend listen port
PORT=8172
HOST=127.0.0.1

# Entry point of the omp bridge the backend spawns as its app-server
# (default: bridge/dist/index.js)
# BRIDGE_BIN=bridge/dist/index.js

# Directory holding the WebUI database and uploads (default: ~/.omp)
# WEBUI_HOME=~/.omp

# SQLite database path (default: WEBUI_HOME/webui.sqlite)
# WEBUI_DB_PATH=

# omp executable used by the bridge (default: omp on PATH)
# OMP_BIN=omp

# Working directory the engine runs in (default: this process's cwd)
# OMP_CWD=

# Session directory the engine reads and writes (default: ~/.omp/agent/sessions)
# OMP_SESSION_DIR=

# Pino log level (default: info)
# LOG_LEVEL=info
